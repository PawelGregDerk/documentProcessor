<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/23.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@/css/mainStyle.css"
      styleClass="rootVBox"
      fx:controller="by.vstu.isit.documentprocessor.controllers.DocPackageEditController"
      spacing="10">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <!-- Название пакета -->
    <GridPane hgap="10" vgap="5">
        <columnConstraints>
            <ColumnConstraints percentWidth="50"/>
            <ColumnConstraints percentWidth="50"/>
        </columnConstraints>

        <!-- Название пакета -->
        <Label text="Название пакета документов"
               styleClass="labelFont"
               GridPane.rowIndex="0"
               GridPane.columnIndex="0"
               GridPane.halignment="CENTER"
               GridPane.valignment="CENTER"/>

        <!-- Название сборочной единицы -->
        <Label text="Название сборочной единицы"
               styleClass="labelFont"
               GridPane.rowIndex="0"
               GridPane.columnIndex="1"
               GridPane.halignment="CENTER"
               GridPane.valignment="CENTER"/>

        <TextField fx:id="packageNameField"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="0"/>

        <TextField fx:id="sborEdNazv"
                   GridPane.rowIndex="1"
                   GridPane.columnIndex="1"/>
    </GridPane>

    <Button text="Добавить сборочную единицу"
            onAction="#onAddAssemblyUnit"
            styleClass="newButton"
            maxWidth="300"/>

    <!-- Контейнер сборочных единиц -->
    <ScrollPane fitToWidth="true" prefHeight="350">
        <content>
            <VBox fx:id="assemblyUnitsContainer" spacing="10"/>
        </content>
    </ScrollPane>

    <!-- Названия документов -->
    <GridPane hgap="10" vgap="10">
        <columnConstraints>
            <ColumnConstraints percentWidth="30"/>
            <ColumnConstraints percentWidth="70"/>
        </columnConstraints>

        <!-- ПУ -->
        <Label text="ПУ:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="labelFont"/>
        <TextField fx:id="puField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <!-- СХПУ -->
        <Label text="СХПУ:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="labelFont"/>
        <TextField fx:id="spuField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <!-- КП -->
        <Label text="КП:" GridPane.rowIndex="3" GridPane.columnIndex="0" styleClass="labelFont"/>
        <TextField fx:id="kpField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <!-- FMEA -->
        <Label text="FMEA:" GridPane.rowIndex="4" GridPane.columnIndex="0" styleClass="labelFont"/>
        <TextField fx:id="fmeaField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

        <!-- Вед. инструкции -->
        <Label text="Вед. инструкции:" GridPane.rowIndex="5" GridPane.columnIndex="0" styleClass="labelFont"/>
        <TextField fx:id="vedInstrField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
    </GridPane>

    <!-- Кнопка добавления операции -->
    <Button text="Добавить операцию"
            onAction="#onAddOperation"
            styleClass="newButton"
            maxWidth="200"/>

    <HBox spacing="20" style="-fx-font-weight: bold;">
        <Label text="№ опер." prefWidth="80"/>
        <Label text="№ инструкции" prefWidth="110"/>
        <Label text="Оборудование" prefWidth="120"/>
        <Label text="Оснастка / Инстр." prefWidth="140"/>
        <Label text="Наименование" prefWidth="140"/>
        <Label text="Шифр" prefWidth="80"/>
        <Label text="Цех" prefWidth="60"/>
        <Label text=""/>
        <Label text=""/>
    </HBox>

    <Separator/>

    <!-- Контейнер операций -->
    <ScrollPane fitToWidth="true" prefHeight="350">
        <content>
            <VBox fx:id="operationsContainer" spacing="10"/>
        </content>
    </ScrollPane>

    <!-- Сохранить -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <padding>
            <Insets top="50"/>
        </padding>

        <Button text="Назад"
                onAction="#onBack"
                styleClass="newButton"
                minWidth="200"/>

        <Button text="Сохранить"
                onAction="#onSave"
                styleClass="buttonSave"
                minWidth="200"/>
    </HBox>

</VBox>
